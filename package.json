{
  "name": "old-prague-photos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "dev:pages": "sh scripts/dev-pages.sh",
    "prepare:community-data": "node scripts/update-community-data-version.mjs",
    "pretest": "npm run prepare:community-data",
    "test": "npm run test:py && npm run test:api && npm run test:d1",
    "test:py": "uv run pytest -q",
    "test:api": "node --test functions/api/__tests__/*.mjs",
    "test:d1": "sh scripts/test-d1.sh",
    "prebuild:viewer": "npm run prepare:community-data",
    "build:viewer": "npm --prefix viewer/react run build",
    "release:verify": "npm test && npm run build:viewer",
    "deploy:pages": "sh scripts/deploy-pages.sh",
    "deploy:pages:staging": "sh scripts/deploy-pages-staging.sh",
    "smoke:pages": "node scripts/smoke-pages.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.110.0"
  }
}
