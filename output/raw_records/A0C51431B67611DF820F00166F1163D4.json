{"typ záznamu": "Archiválie", "signatura": "I 6523", "heslo": "Praha - události 1945 - Pražské povstání", "druh": "pozitiv", "obsah": "Pražské povstání - 9.5.1945. Kolona německých vozidel a vojáků na Staroměstském náměstí před ústím Celetné ulice. Pražská posádka vojsk SS spolu s dalšími bojovými skupinami postupovala časně ráno 9.5. od svého velitelství v budově právnické fakulty přes dnešní Palachovo, Malé a Staroměstské náměstí do Celetné ulice směrem na Vinohrady.", "datace": "9.5.1945", "zobrazeno": "291x", "xid": "A0C51431B67611DF820F00166F1163D4", "rejstříkové záznamy": [{"typ": "Čas", "obsah": "Pražské povstání (1945 : Praha, Česko)"}, {"typ": "Místo", "obsah": "Celetná"}, {"typ": "Místo", "obsah": "Staré Město"}, {"typ": "Místo", "obsah": "Staroměstské náměstí"}], "scan_count": 1, "scan_indices": [0], "scan_previews": ["https://images.ahmp.cz/mrimage/ahmp_watermark/image/cz/archives/CZ-321100010/NAD-157/dao/images/0016/f2571c103b1347e3a529a0930f6a5ab4.jpg/nahled_maly.jpg"], "scan_zoomify_paths": ["https://images.ahmp.cz/mrimage/ahmp_watermark/zoomify/cz/archives/CZ-321100010/NAD-157/dao/images/0016/f2571c103b1347e3a529a0930f6a5ab4.jpg"], "has_scans": false}