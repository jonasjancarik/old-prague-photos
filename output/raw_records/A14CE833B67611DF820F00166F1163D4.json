{"typ záznamu": "Archiválie", "signatura": "VI 61/6", "heslo": "Praha-Staré Město - Staroměstské náměstí", "druh": "pozitiv", "obsah": "Pohled na západní stranu Staroměstského náměstí. Uprostřed Staroměstská radnice s věží, arkýřem a se strážnicí, vlevo domy jižní strany náměstí při ústí Železné ulice a mariánský sloup. Vpravo dům čp. 936 (Krenův) a dům čp. 935. Nad nimi věže kostela sv. Mikuláše.", "autor": "Fridrich, František (1829-1892)", "datace": "1868", "zobrazeno": "96x", "xid": "A14CE833B67611DF820F00166F1163D4", "rejstříkové záznamy": [], "scan_count": 2, "scan_indices": [0, 1], "scan_previews": ["https://images.ahmp.cz/mrimage/ahmp_watermark/image/cz/archives/CZ-321100010/NAD-157/dao/images/0019/21df05af41dbc9597a21cdf4b09aae41.jpg/nahled_maly.jpg", "https://images.ahmp.cz/mrimage/ahmp_watermark/image/cz/archives/CZ-321100010/NAD-157/dao/images/0019/21df05af41dbc9597a21cdf4b09aae41.jpg/nahled_maly.jpg"], "scan_zoomify_paths": ["https://images.ahmp.cz/mrimage/ahmp_watermark/zoomify/cz/archives/CZ-321100010/NAD-157/dao/images/0019/21df05af41dbc9597a21cdf4b09aae41.jpg", "https://images.ahmp.cz/mrimage/ahmp_watermark/zoomify/cz/archives/CZ-321100010/NAD-157/dao/images/0019/21df05af41dbc9597a21cdf4b09aae41.jpg"], "has_scans": true}