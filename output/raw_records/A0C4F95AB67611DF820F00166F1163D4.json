{"typ záznamu": "Archiválie", "signatura": "VIII 888", "heslo": "Praha-Malá Strana - Malostranské náměstí", "druh": "negativ", "obsah": "Pohled na severovýchodní stranu Malostranského náměstí s ústím Letenské a Tomášské ulice. Zleva domy s podloubím čp. 7 a čp. 518, vpravo malostranská radnice (dům čp. 35 na Malé Straně). Uprostřed v pozadí kostel sv. Tomáše.", "autor": "Eckert-ateliér", "datace": "1905", "zobrazeno": "80x", "xid": "A0C4F95AB67611DF820F00166F1163D4", "rejstříkové záznamy": [{"typ": "Dílo", "obsah": "dům čp. 35 (Praha-Malá Strana); radnice, malostranská beseda"}, {"typ": "Dílo", "obsah": "dům čp. 518 (Praha-Malá Strana)"}, {"typ": "Dílo", "obsah": "dům čp. 7 (Praha-Malá Strana)"}, {"typ": "Dílo", "obsah": "kostel sv. Tomáše (Praha-Malá Strana)"}, {"typ": "Místo", "obsah": "Letenská"}, {"typ": "Místo", "obsah": "Malá Strana"}, {"typ": "Místo", "obsah": "Malostranské náměstí"}, {"typ": "Místo", "obsah": "Tomášská"}, {"typ": "Osoba", "obsah": "Eckert-ateliér"}], "scan_count": 1, "scan_indices": [0], "scan_previews": ["https://images.ahmp.cz/mrimage/ahmp_watermark/image/cz/archives/CZ-321100010/NAD-157/dao/images/0020/b4e32f6458c297dbe0951c9a5378399e.jpg/nahled_maly.jpg"], "scan_zoomify_paths": ["https://images.ahmp.cz/mrimage/ahmp_watermark/zoomify/cz/archives/CZ-321100010/NAD-157/dao/images/0020/b4e32f6458c297dbe0951c9a5378399e.jpg"], "has_scans": false}