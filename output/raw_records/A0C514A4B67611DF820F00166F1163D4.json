{"typ záznamu": "Archiválie", "signatura": "VIII 974", "heslo": "Praha-Staré Město - panorama", "druh": "negativ", "obsah": "Panoramatický pohled z Letné na Staré Město a Josefov při asanaci. V popředí stavba nábřeží, stavba mostu Svatopluka Čecha, staveniště nových domů a demolice původní zástavby (Velkodvorská synagoga). Vpravo nově vznikající Pařížská třída (Mikulášská) s domy čp. 883 a čp. 206. V pozadí uprostřed věže kostela P. Marie před Týnem.", "autor": "Eckert-ateliér", "datace": "24.5.1906", "zobrazeno": "163x", "xid": "A0C514A4B67611DF820F00166F1163D4", "rejstříkové záznamy": [{"typ": "Dílo", "obsah": "Čechův most (Praha, Česko : most : 1908-)"}, {"typ": "Dílo", "obsah": "dům čp. 201 (Praha-Josefov); Velkodvorská synagoga"}, {"typ": "Dílo", "obsah": "dům čp. 206 (Praha-Staré Město)"}, {"typ": "Dílo", "obsah": "dům čp. 883 (Praha-Staré Město)"}, {"typ": "Dílo", "obsah": "kostel Panny Marie před Týnem (Staré Město, Praha, Česko : kostel)"}, {"typ": "Místo", "obsah": "Josefov"}, {"typ": "Místo", "obsah": "nábřeží Na Františku"}, {"typ": "Místo", "obsah": "Pařížská"}, {"typ": "Místo", "obsah": "Staré Město"}, {"typ": "Osoba", "obsah": "Eckert-ateliér"}], "scan_count": 2, "scan_indices": [0, 1], "scan_previews": ["https://images.ahmp.cz/mrimage/ahmp_watermark/image/cz/archives/CZ-321100010/NAD-157/dao/images/0020/00ff19e2ade04cd63526c94389b9e03c.jpg/nahled_maly.jpg", "https://images.ahmp.cz/mrimage/ahmp_watermark/image/cz/archives/CZ-321100010/NAD-157/dao/images/0020/fa1bb3e210ca601ffd88bbeb99bf2b73.jpg/nahled_maly.jpg"], "scan_zoomify_paths": ["https://images.ahmp.cz/mrimage/ahmp_watermark/zoomify/cz/archives/CZ-321100010/NAD-157/dao/images/0020/00ff19e2ade04cd63526c94389b9e03c.jpg", "https://images.ahmp.cz/mrimage/ahmp_watermark/zoomify/cz/archives/CZ-321100010/NAD-157/dao/images/0020/fa1bb3e210ca601ffd88bbeb99bf2b73.jpg"], "has_scans": true}