{"typ záznamu": "Archiválie", "signatura": "I 11366", "heslo": "Praha-Košíře - Cibulka", "druh": "pozitiv", "obsah": "Panoramatický pohled na stráň vedoucí od konce Košíř k Cibulce v pohledovém kruhu od jihu přes západ k severozápadu. Terén je upravován pro vilovou zástavbu, z nichž některé mají hotové už přízemí. Druhý díl třídílného panoramatu.", "autor": "Alexander, Antonín (1892-působnost do 1948)", "datace": "16.10.1924", "zobrazeno": "103x", "xid": "5C6DFC94878F11E5A334406186009F3A", "rejstříkové záznamy": [{"typ": "Místo", "obsah": "Košíře"}, {"typ": "Místo", "obsah": "KOŠÍŘE-Cibulka"}, {"typ": "Osoba", "obsah": "Alexander, Antonín (1892-působnost do 1948)"}, {"typ": "Věc. objekt", "obsah": "panoramatické pohledy"}], "scan_count": 1, "scan_indices": [0], "scan_previews": ["https://images.ahmp.cz/mrimage/ahmp_watermark/image/cz/archives/CZ-321100010/NAD-157/dao/images/0023/a8fa0b8d6b86caae6bea3d5ce15e7c1f.jpg/nahled_maly.jpg"], "scan_zoomify_paths": ["https://images.ahmp.cz/mrimage/ahmp_watermark/zoomify/cz/archives/CZ-321100010/NAD-157/dao/images/0023/a8fa0b8d6b86caae6bea3d5ce15e7c1f.jpg"], "has_scans": false}