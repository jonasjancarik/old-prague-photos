{"typ záznamu": "Archiválie", "signatura": "I 9801", "heslo": "Praha-Staré Město - dům čp. 655", "druh": "pozitiv", "obsah": "Pohled na část prostranství po zbořeném domě čp. 655 na Starém Městě (Ústav šlechtičen) při náměstí Republiky k východu. Uprostřed základy novostavby domu čp. 655 (dům pojišťovny Kotva) na Starém Městě a zbytek sklepení. V pozadí vpravo domy na Novém Městě čp. 1078 - 1079 (kasárna Jiřího z Poděbrad - Josefská) a vlevo dům čp. 1080.", "autor": "Alexander, Antonín (1892-působnost do 1948)", "datace": "21.3.1928", "zobrazeno": "138x", "xid": "0FA5EF96161211E390486C626D41E503", "rejstříkové záznamy": [{"typ": "Dílo", "obsah": "dům čp. 1078-1079 (Praha-Nové Město)"}, {"typ": "Dílo", "obsah": "dům čp. 1079 (Praha-Nové Město)"}, {"typ": "Dílo", "obsah": "dům čp. 1080 (Praha-Nové Město)"}, {"typ": "Dílo", "obsah": "dům čp. 655 (Praha-Staré Město)"}, {"typ": "Místo", "obsah": "náměstí Republiky"}, {"typ": "Místo", "obsah": "Revoluční"}, {"typ": "Místo", "obsah": "Staré Město"}, {"typ": "Osoba", "obsah": "Alexander, Antonín (1892-působnost do 1948)"}], "scan_count": 1, "scan_indices": [0], "scan_previews": ["https://images.ahmp.cz/mrimage/ahmp_watermark/image/cz/archives/CZ-321100010/NAD-157/dao/images/0016/a2edce0aac08ccfc87646111895de0c5.jpg/nahled_maly.jpg"], "scan_zoomify_paths": ["https://images.ahmp.cz/mrimage/ahmp_watermark/zoomify/cz/archives/CZ-321100010/NAD-157/dao/images/0016/a2edce0aac08ccfc87646111895de0c5.jpg"], "has_scans": false}