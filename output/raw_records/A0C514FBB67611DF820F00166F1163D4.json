{"typ záznamu": "Archiválie", "signatura": "VI 77/2 c", "heslo": "Praha-panorama", "druh": "pozitiv", "obsah": "Panoramatický pohled na Prahu z Mariánské bašty (od severozápadu) \"Praha roku 1894\". Vlevo ostrov Štvanice, vpravo Pražský hrad a rozhledna na Petříně. V popředí zleva Občanská plovárna, Jezuitská zahrada, Klárov, Malá Strana. V pozadí za řekou nábřeží Na Františku, Dvořákovo nábřeží, Rudolfinum (dům čp. 79 na Starém Městě), Uměleckoprůmyslová škola (dům čp. 80 na Starém Městě), Alšovo nábřeží, Železná lávka, Karlův most.", "autor": "Bellmann, Karel", "datace": "1894", "zobrazeno": "172x", "xid": "A0C514FBB67611DF820F00166F1163D4", "rejstříkové záznamy": [{"typ": "Dílo", "obsah": "dům čp. 337 (Holešovice, Praha, Česko : budova)"}, {"typ": "Dílo", "obsah": "Pražský hrad (Hradčany, Praha, Česko : stavba)"}, {"typ": "Místo", "obsah": "náměstí Klárov"}, {"typ": "Místo", "obsah": "Praha-panorama"}, {"typ": "Místo", "obsah": "Vltava"}, {"typ": "Osoba", "obsah": "Bellmann, Karel"}, {"typ": "Osoba", "obsah": "Rada král. hlavního města Prahy"}], "scan_count": 3, "scan_indices": [0, 1, 2], "scan_previews": ["https://images.ahmp.cz/mrimage/ahmp_watermark/image/cz/archives/CZ-321100010/NAD-157/dao/images/0019/de53cb3a0c4f2d07cdc32ae4ef802742.jpg/nahled_maly.jpg", "https://images.ahmp.cz/mrimage/ahmp_watermark/image/cz/archives/CZ-321100010/NAD-157/dao/images/0019/365625d87ab9610ab393b8ba7c4be8b9.jpg/nahled_maly.jpg", "https://images.ahmp.cz/mrimage/ahmp_watermark/image/cz/archives/CZ-321100010/NAD-157/dao/images/0019/482630cc0617af737662e27687d16422.jpg/nahled_maly.jpg"], "scan_zoomify_paths": ["https://images.ahmp.cz/mrimage/ahmp_watermark/zoomify/cz/archives/CZ-321100010/NAD-157/dao/images/0019/de53cb3a0c4f2d07cdc32ae4ef802742.jpg", "https://images.ahmp.cz/mrimage/ahmp_watermark/zoomify/cz/archives/CZ-321100010/NAD-157/dao/images/0019/365625d87ab9610ab393b8ba7c4be8b9.jpg", "https://images.ahmp.cz/mrimage/ahmp_watermark/zoomify/cz/archives/CZ-321100010/NAD-157/dao/