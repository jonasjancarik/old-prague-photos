{"typ záznamu": "Archiválie", "signatura": "I 11367", "heslo": "Praha-Košíře - Cibulka", "druh": "pozitiv", "obsah": "Panoramatický pohled na stráň vedoucí od konce Košíř k Cibulce v pohledovém kruhu od jihu přes západ k severozápadu. Terén je upravován pro vilovou zástavbu, z nichž některé mají hotové už přízemí. Třetí díl třídílného panoramatu.", "autor": "Alexander, Antonín (1892-působnost do 1948)", "datace": "16.10.1924", "zobrazeno": "102x", "xid": "720E8450878F11E5A334406186009F3A", "rejstříkové záznamy": [{"typ": "Místo", "obsah": "Košíře"}, {"typ": "Místo", "obsah": "KOŠÍŘE-Cibulka"}, {"typ": "Osoba", "obsah": "Alexander, Antonín (1892-působnost do 1948)"}, {"typ": "Věc. objekt", "obsah": "panoramatické pohledy"}], "scan_count": 1, "scan_indices": [0], "scan_previews": ["https://images.ahmp.cz/mrimage/ahmp_watermark/image/cz/archives/CZ-321100010/NAD-157/dao/images/0023/0f955ca43d1315b1344b2a08d9f91d11.jpg/nahled_maly.jpg"], "scan_zoomify_paths": ["https://images.ahmp.cz/mrimage/ahmp_watermark/zoomify/cz/archives/CZ-321100010/NAD-157/dao/images/0023/0f955ca43d1315b1344b2a08d9f91d11.jpg"], "has_scans": false}