{"typ záznamu": "Archiválie", "signatura": "A 2374", "heslo": "Praha-Hlubočepy - panorama", "druh": "pozitiv", "obsah": "Pohled z Barrandovské skály k severu. V popředí Barrandovská skála a poslední hlubočepské domy Prokopského údolí. Nad nimi kostel sv. Filipa a Jakuba na skále na Zlíchově a vpravo vltavské údolí s Braníkem a s Podolím. Součást panoramatu.", "autor": "Alexander, Antonín (1892-působnost do 1948)", "datace": "4.4.1926", "zobrazeno": "158x", "xid": "FA93DF60035211E7A51174D435EEBE90", "rejstříkové záznamy": [{"typ": "Osoba", "obsah": "Alexander, Antonín (1892-působnost do 1948)"}], "scan_count": 1, "scan_indices": [0], "scan_previews": ["https://images.ahmp.cz/mrimage/ahmp_watermark/image/cz/archives/CZ-321100010/NAD-157/dao/images/0023/462d3573dfce18159891a9d96e2654f7.jpg/nahled_maly.jpg"], "scan_zoomify_paths": ["https://images.ahmp.cz/mrimage/ahmp_watermark/zoomify/cz/archives/CZ-321100010/NAD-157/dao/images/0023/462d3573dfce18159891a9d96e2654f7.jpg"], "has_scans": false}