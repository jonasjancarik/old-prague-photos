{"typ záznamu": "Archiválie", "signatura": "VI 77/2 c", "druh": "pozitiv", "obsah": "Panoramatický pohled na Prahu z Mariánské bašty (od severozápadu) \"Praha roku 1894\". Vlevo ostrov Štvanice, vpravo Pražský hrad a rozhledna na Petříně. V popředí zleva Občanská plovárna, Jezuitská zahrada, Klárov, Malá Strana. V pozadí za řekou nábřeží Na Františku, Dvořákovo nábřeží, Rudolfinum (dům čp. 79 na Starém Městě), Uměleckoprůmyslová škola (dům čp. 80 na Starém Městě), Alšovo nábřeží, Železná lávka, Karlův most.", "autor": "Bellmann, Karel", "datace": "1894", "zobrazeno": "126x", "xid": "A0C514FBB67611DF820F00166F1163D4", "rejstříkové záznamy": [{"typ": "Dílo", "obsah": "dům čp. 337 (Praha-Holešovice); Občanská plovárna, plovárna Pod Letnou"}, {"typ": "Dílo", "obsah": "Pražský hrad (Praha-Hradčany)"}, {"typ": "Místo", "obsah": "náměstí Klárov"}, {"typ": "Místo", "obsah": "Praha-panorama"}, {"typ": "Místo", "obsah": "Vltava"}, {"typ": "Osoba", "obsah": "Bellmann, Karel"}, {"typ": "Osoba", "obsah": "Rada král. hlavního města Prahy"}], "geolocation": {"name": "U plovárny 337/1", "label": "Adresa", "position": {"lon": 14.41492, "lat": 50.0931}, "type": "regional.address", "location": "Praha 1 - Holešovice, Česko", "regionalStructure": [{"name": "337/1", "type": "regional.address"}, {"name": "U plovárny", "type": "regional.street"}, {"name": "Holešovice", "type": "regional.municipality_part"}, {"name": "Praha 1", "type": "regional.municipality_part"}, {"name": "Praha", "type": "regional.municipality"}, {"name": "okres Hlavní město Praha", "type": "regional.region"}, {"name": "kraj Hlavní město Praha", "type": "regional.region"}, {"name": "Česko", "type": "regional.country", "isoCode": "CZ"}], "zip": "118 00", "endpoint": "geocode"}, "scan_count": 3, "scan_previews": ["https://images.ahmp.cz/mrimage/ahmp_watermark/image/cz/archives/CZ-321100010/NAD-157/dao/images/0019/de53cb3a0c4f2d07cdc32ae4ef802742.jpg/nahled_maly.jpg", "https://images.ahmp.cz/mrimage/ahmp_watermark/image/cz